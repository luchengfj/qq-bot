{
  "name": "@local/qq-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-download QQ bot channel plugin for DeepSeek Harness — an in-panel direct-chat test with no install, an optional connection to an already-running OneBot v11 forward/reverse WebSocket server, and the Harness-native model by default (no API key).",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/luchengfj/qq-bot" },
  "keywords": ["dsh-plugin", "qq", "onebot", "onebot-v11", "zero-download", "direct-chat", "chatbot", "vision", "deepseek-harness"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": { "dsh": ">=0.1.7-rc.1" }
}
